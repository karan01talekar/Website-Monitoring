# Server and database
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/website_monitoring
CLIENT_ORIGIN=http://127.0.0.1:5173

# Use a long, random value and keep it private. Required for stable production auth tokens.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Set true only for local development to check localhost URLs such as http://localhost:3000.
# Keep false in production to prevent monitoring private network addresses.
ALLOW_LOCAL_TARGETS=false

# Resend alert delivery. Verify the sender domain in Resend before using it.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=alerts@example.com
MAIL_FROM_NAME=Website Monitoring
