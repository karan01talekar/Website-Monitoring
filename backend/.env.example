# Server and database
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/website_monitoring
CLIENT_ORIGIN=http://127.0.0.1:5173

# Set true only for local development to check localhost URLs such as http://localhost:3000.
# Keep false in production to prevent monitoring private network addresses.
ALLOW_LOCAL_TARGETS=false

# SMTP alert delivery. Leave SMTP_HOST empty to disable outage emails locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Website Monitoring <alerts@example.com>
